@article{schaefer2026laststraw,
  bibtex_show = {true},
  category    = {working},
  title       = {The Last Straw (and Take-out Container)? The Effect of Plastic Foodware Policies on Shoreline Litter},
  author      = {Schaefer, Jenna and Taylor, Rebecca L.C. and Yuwen, Rong},
  journal     = {SSRN Working Paper},
  year        = {2026},
  abstract    = {Shoreline plastic litter is a growing environmental concern. Governments worldwide have enacted policies to restrict the consumption of single-use plastic items in recent years. This paper examines whether these consumption policies have also been effective in reducing shoreline plastic litter. Using citizen science litter data and a staggered event study design, we examine the effect of policies across the US that restrict the consumption of single-use polystyrene foam food containers and plastic straws at restaurants. We find that polystyrene foam bans are effective in reducing foam food container litter, with a statistically significant 26--39\% decline in the amount of food container litter collected per volunteer after the implementation of a foam ban. Heterogeneity analyses reveal the largest reductions in foam food container litter in areas with a higher share of fast-food restaurants. Conversely, upon-request straw policies are not found to be effective in reducing straw litter. This research has important implications for policymakers considering command-and-control versus nudge-like policies for future regulation of single-use plastic items.},
  pdf         = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6615912}
}

@article{chen2025kcup,
  bibtex_show = {true},
  category    = {working},
  title       = {Market and Environmental Impact of Reusable Products: An Application to the K-Cup Coffee System},
  author      = {Chen, Youning and Yuwen, Rong},
  journal     = {SSRN Working Paper},
  year        = {2025},
  abstract    = {We develop an empirical framework to quantify the economic and environmental impacts of reusable products, using the single-serve coffee industry as a case study. Our analysis focuses on Keurig's My K-Cup, a reusable alternative to disposable coffee pods. First, we present reduced-form evidence from a difference-in-differences design, showing that access to reusable pods significantly decreases consumer demand for disposable pods. We then estimate a structural demand model that incorporates consumer ownership of reusable pods to capture substitution patterns between reusable and single-serve products. Using the estimated model, we simulate a counterfactual scenario without the introduction of reusable pods and find that disposable pod sales would have been over 50\% higher between 2008 and 2014, generating 1.86 billion additional pods and roughly \$93 million in plastic-related environmental externalities. Our findings underscore the role of reusable alternatives in curbing plastic waste and offer a scalable approach for evaluating similar interventions in markets where durable and disposable products coexist.},
  pdf         = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5387557}
}

@article{yuwen2026greenwall,
  bibtex_show = {true},
  category    = {working},
  title       = {Local Benefits? The Great Green Wall's Impact on Local Residential Land Price},
  author      = {Yuwen, Rong},
  journal     = {Working paper},
  year        = {2026},
  abstract    = {In 1978, China launched the Three-North Shelter Forest Program (TNSFP), a large-scale afforestation initiative. This study evaluates the program's impact on local residential land prices, focusing on counties that joined after 2011 compared with counties that had not participated before 2020. Using a Difference-in-Differences approach and county-level data on residential land prices, air quality, and socio-economic indicators from 2007 onward, I find that residential land prices increased by about 22\% in participating counties. The effect varies by market structure: properties sold through government public auctions experienced smaller price increases than those sold through fixed-price (``take-it-or-leave-it'') arrangements. Air-quality improvements account for only a small part of the overall effect. The strongest gains are observed in medium- and smaller-sized cities, rather than in the largest urban centers.}
}

